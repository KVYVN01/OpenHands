# oh-pro configuration
OPENHANDS_PORT=3000
OH_VERSION=1.7.0
OH_BASE_IMAGE=ghcr.io/openhands/openhands
AGENT_SERVER_IMAGE_REPOSITORY=ghcr.io/openhands/agent-server
AGENT_SERVER_IMAGE_TAG=1.7.0-python

# Required before real LLM sessions
ANTHROPIC_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-4-5

# Optional OpenAI-compatible provider
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

SWD_MODE=strict
MEMORY_THRESHOLD_LINES=500
MEMORY_KEEP_RECENT=50
COMPACT_MODEL=claude-haiku-4-5-20251001
